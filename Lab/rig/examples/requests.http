# Reference requests for an HTTP client. Nothing in this file has been sent.
# Set token privately; replace IDs and revision after creating resources.
@base = http://127.0.0.1:8787
@token = REPLACE_PRIVATELY
@dataset = REPLACE_DATASET_ID
@candidate = REPLACE_CANDIDATE_ID
@job = REPLACE_JOB_ID
@report = REPLACE_REPORT_ID

### Health
GET {{base}}/health

### Import the synthetic example
POST {{base}}/api/v1/datasets
Authorization: Bearer {{token}}
Content-Type: application/json

< ./dataset.json

### Register a pinned base model; does not download it
POST {{base}}/api/v1/candidates
Authorization: Bearer {{token}}
Content-Type: application/json

{"name":"qwen-base","repo_id":"mlx-community/Qwen3-0.6B-bf16","revision":"REPLACE_WITH_ACTUAL_40_CHARACTER_COMMIT_SHA"}

### Queue a complete pipeline; requires an explicit worker to execute
POST {{base}}/api/v1/pipelines
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "training": {"base_candidate_id":"{{candidate}}","dataset_id":"{{dataset}}","batch_size":2,"iterations":100},
  "evaluation": {"dataset_id":"{{dataset}}","metric":"numeric","gate":{"min_score":0.9}},
  "optimization": {"strategy":"quantize","bits":4,"max_score_drop":0.01,"max_latency_ratio":1.0}
}

### Inspect job
GET {{base}}/api/v1/jobs/{{job}}
Authorization: Bearer {{token}}

### Inspect stage events
GET {{base}}/api/v1/jobs/{{job}}/events
Authorization: Bearer {{token}}

### Cancel job
POST {{base}}/api/v1/jobs/{{job}}/cancel
Authorization: Bearer {{token}}

### Inspect validation failures
GET {{base}}/api/v1/evaluations/{{report}}/failures
Authorization: Bearer {{token}}

### Promote only a passing report
POST {{base}}/api/v1/deployments
Authorization: Bearer {{token}}
Content-Type: application/json

{"name":"specialist","report_id":"{{report}}"}

### Inference, only when execution is explicitly enabled
POST {{base}}/v1/chat/completions
Authorization: Bearer {{token}}
Content-Type: application/json

{"model":"specialist","messages":[{"role":"user","content":"What is 11 plus 4? Reply with a number only."}],"max_tokens":32,"stream":false}
