# Templates only; no requests have been sent. Replace all placeholder IDs.
@base = http://127.0.0.1:8787
@token = REPLACE_WITH_LOCAL_TOKEN
@workflow = REPLACE_WITH_WORKFLOW_ID
@cycle = REPLACE_WITH_CYCLE_ID
@release = REPLACE_WITH_RELEASE_JOB_ID
@request = REPLACE_WITH_SERVING_REQUEST_ID
@feedback = REPLACE_WITH_FEEDBACK_ID
@review = REPLACE_WITH_APPROVED_REVIEW_ID

### Import locally staged weights; poll job.result.id for the candidate ID
POST {{base}}/api/v1/candidates/import-local
Authorization: Bearer {{token}}
Content-Type: application/json

{"name":"local-base","directory":"qwen-base"}

### Create workflow after replacing sample IDs in workflow.json
POST {{base}}/api/v1/workflows
Authorization: Bearer {{token}}
Content-Type: application/json

< ./workflow.json

### First cycle (queues only; does not start a worker)
POST {{base}}/api/v1/workflows/{{workflow}}/cycles
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### Inspect the cycle
GET {{base}}/api/v1/workflows/{{workflow}}/cycles/{{cycle}}
Authorization: Bearer {{token}}

### Request held-out audit after an accepted cycle
POST {{base}}/api/v1/workflows/{{workflow}}/cycles/{{cycle}}/release
Authorization: Bearer {{token}}
Content-Type: application/json

{"reviewer":"workflow-owner","note":"Validation reviewed; request final audit"}

### Explicit promotion after the release job passes
POST {{base}}/api/v1/workflows/{{workflow}}/cycles/{{cycle}}/promote
Authorization: Bearer {{token}}
Content-Type: application/json

{"release_job_id":"{{release}}","name":"support-routing"}

### Serve; retain X-Rig-Request-Id for feedback
POST {{base}}/v1/chat/completions
Authorization: Bearer {{token}}
Content-Type: application/json

{"model":"support-routing","messages":[{"role":"user","content":"A new production request"}],"stream":false}

### Record failure
POST {{base}}/api/v1/feedback
Authorization: Bearer {{token}}
Content-Type: application/json

{"request_id":"{{request}}","rating":"bad"}

### Review (requires retained input from the original request)
POST {{base}}/api/v1/feedback/{{feedback}}/review
Authorization: Bearer {{token}}
Content-Type: application/json

{"decision":"approve","reviewer":"domain-expert","reason":"Verified route","correction":"escalate"}

### Next cycle: append approved feedback, preserve holdouts
POST {{base}}/api/v1/workflows/{{workflow}}/cycles
Authorization: Bearer {{token}}
Content-Type: application/json

{"parent_cycle_id":"{{cycle}}","feedback_review_ids":["{{review}}"]}
